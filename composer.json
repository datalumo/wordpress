{
    "name": "datalumo/wordpress-plugin",
    "description": "Datalumo WordPress integration: content sync, AI search and chat widgets.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Jeffrey van Rossum",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "automattic/jetpack-autoloader": "^3.0",
        "woocommerce/action-scheduler": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Datalumo\\Wp\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "automattic/jetpack-autoloader": true
        }
    }
}
