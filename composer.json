{
    "name": "datalumo/wordpress-plugin",
    "description": "Datalumo WordPress integration: content sync, AI search and chat widgets.",
    "type": "wordpress-plugin",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Jeffrey van Rossum",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "automattic/jetpack-autoloader": "^3.0",
        "woocommerce/action-scheduler": "^3.0"
    },
    "autoload": {
        "psr-4": {
            "Datalumo\\Wp\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Datalumo\\Wp\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "automattic/jetpack-autoloader": true,
            "pestphp/pest-plugin": true
        }
    },
    "require-dev": {
        "pestphp/pest": "^4.7",
        "brain/monkey": "^2.7"
    },
    "scripts": {
        "test": "pest",
        "fresh-site": "bin/fresh-site",
        "post-autoload-dump": "@php bin/ensure-index-php"
    }
}
